{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    /* Configurações para Node Moderno (ESM) */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "types": [],
    /* Regras de Tolerância */
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false, /* Desativamos isso para não dar erro nos imports */
    "sourceMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}